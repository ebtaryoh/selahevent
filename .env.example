# Database — local PostgreSQL (Supabase works identically via connection string)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Public site origin, used for canonical URLs, Open Graph metadata and sitemaps
NEXT_PUBLIC_APP_URL=https://selah.example.com

# ---------------------------------------------------------------------------
# Payments (Paystack first; the gateway abstraction lives in
# src/app/api/registrations/route.ts and can be extended for other providers)
# ---------------------------------------------------------------------------
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
# "live" switches verification to Paystack's production API. Anything else is
# treated as test mode and is surfaced in the UI rather than hidden.
PAYSTACK_MODE=test

# ---------------------------------------------------------------------------
# Communications — GMail App Passwords
# ---------------------------------------------------------------------------
GMAIL_USER=events@yourdomain.com
GMAIL_APP_PASSWORD=your_16_digit_app_password
SMS_PROVIDER_API_KEY=
WHATSAPP_PROVIDER_API_KEY=

# ---------------------------------------------------------------------------
# Storage (event assets, logos, speaker photos, certificate designs)
# ---------------------------------------------------------------------------
STORAGE_BUCKET=event-assets
STORAGE_PUBLIC_URL=

# ---------------------------------------------------------------------------
# Platform
# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------
# Authentication — signs the org session JWT cookie
# Generate with: openssl rand -hex 32
# REQUIRED in production; a dev-only fallback is used locally (with a warning)
# ---------------------------------------------------------------------------
AUTH_SECRET=

RATE_LIMIT_PER_MINUTE=60
# Comma-separated list of origins allowed to call the API from a browser
ALLOWED_ORIGINS=

# ---------------------------------------------------------------------------
# Google Authentication (OAuth SSO)
# Create credentials in the Google Cloud Console
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
